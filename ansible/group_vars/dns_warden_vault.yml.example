# Encrypt this file with ansible-vault (ansible-vault encrypt dns_warden_vault.yml)
pihole_passwords:
  trusted: "changeme-secret"
  iot: "changeme-secret"

dnscrypt_socks:
  trusted_user: trusted
  trusted_pass: "changeme-secret"
  iot_user: iot
  iot_pass: "changeme-secret"

# Required by the maintained Advanced deployer. Keep these stable on redeploy.
torhole_admin_password: "CHANGE_ME"
tor_control_password: "CHANGE_ME"
# Internal Authelia/API secrets are generated on first deployment and retained
# in the installed .env on subsequent Ansible runs.
